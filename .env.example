# ------------------------------------------------------------------
# TranTwin environment configuration — EXAMPLE (safe to commit).
# Copy to .env and fill in real values.
# NEVER commit the real .env — it is gitignored.
# ------------------------------------------------------------------

# ----- Azure AD B2C: public values (safe to inline in the client) ----
NEXT_PUBLIC_AZURE_B2C_TENANT_NAME=<your-b2c-tenant>
NEXT_PUBLIC_AZURE_B2C_CLIENT_ID=<application-client-id>
NEXT_PUBLIC_AZURE_B2C_REDIRECT_URI=http://localhost:3000/auth
NEXT_PUBLIC_AZURE_B2C_SCOPE=openid profile
NEXT_PUBLIC_AZURE_B2C_FLOW_LOGIN=B2C_1_TranTwin_Login
NEXT_PUBLIC_AZURE_B2C_FLOW_REGISTER=B2C_1_TranTwin_Register
NEXT_PUBLIC_AZURE_B2C_FLOW_PASSWORD_RESET=B2C_1_TranTwin_PasswordReset

# ----- Azure AD B2C: server-only secret -------------------------------
# Used by the token-exchange Route Handler. Never expose via NEXT_PUBLIC_.
AZURE_B2C_CLIENT_SECRET=<client-secret>

# ----- Clinic AI backend ----------------------------------------------
NEXT_PUBLIC_CLINIC_API_URL=<https://your-clinic-api.example/v1/clinic>
CLINIC_API_BEARER_TOKEN=<service-account-token>